<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sambient.App.ViewModels"
             xmlns:c="using:Sambient.App.Controls"
             x:Class="Sambient.App.Views.SequencerPanel"
             x:DataType="vm:MainViewModel">
  <StackPanel Spacing="10">
    <!-- modes + page selector -->
    <Grid ColumnDefinitions="*,Auto">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding LayerTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,14,0" VerticalAlignment="Center">
          <Button Classes="seg" Classes.on="{Binding StepsViewVisible}" Content="STEPS" Command="{Binding ShowStepsViewCommand}"
                  ToolTip.Tip="The 16-step button grid" />
          <Button Classes="seg" Classes.on="{Binding PianoRollView}" Content="PIANO ROLL" Command="{Binding ShowPianoRollViewCommand}"
                  ToolTip.Tip="Edit the notes of this layer's track on a pitch x time grid" />
        </StackPanel>
        <ToggleButton Classes="small amber" Content="AUTO-STEP" IsChecked="{Binding AutoStep}" Margin="0,0,6,0"
                      ToolTip.Tip="Step record: advance the cursor when the keys are released" />
        <ToggleButton Classes="small amber" Content="TIE" IsChecked="{Binding TieMode}" Margin="0,0,6,0"
                      ToolTip.Tip="Tie input: click the start step, play and hold a key, click the end step" />
        <ToggleButton Classes="small blue" Content="FOLLOW" IsChecked="{Binding FollowPlayhead}" Margin="0,0,10,0"
                      ToolTip.Tip="The visible page follows the playhead" />
        <TextBlock Text="{Binding TieHint}" Classes="caption" Foreground="#ffb454" VerticalAlignment="Center" />
      </WrapPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Pages}" IsVisible="{Binding StepsViewVisible}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SelectorItemViewModel">
            <Button Classes="seg" Classes.on="{Binding IsSelected}" Content="{Binding Text}" Command="{Binding SelectCommand}"
                    IsEnabled="{Binding IsEnabled}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- the 16 step buttons of the page -->
    <ItemsControl x:Name="StepGridView" ItemsSource="{Binding StepCells}" IsVisible="{Binding StepsViewVisible}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="16" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StepCellViewModel">
          <Border Classes="step" Classes.on="{Binding HasNotes}" Classes.play="{Binding IsPlayhead}" Classes.sel="{Binding IsSelected}"
                  Classes.off="{Binding !InLength}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="4,2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#c4c9d6" />
                <TextBlock Grid.Column="1" Text="{Binding NoteCountText}" FontSize="10" FontWeight="Bold" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Bottom">
                <Ellipse Width="7" Height="7" Fill="#ffb454" IsVisible="{Binding HasLocks}" VerticalAlignment="Center" ToolTip.Tip="Has parameter locks" />
                <TextBlock Grid.Column="1" Text="{Binding ProbabilityText}" FontSize="10" Foreground="#ffd9a0" HorizontalAlignment="Right" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,*" Height="5" Margin="-4,2,-4,0">
                <Border Grid.Column="0" Background="#7be495" IsVisible="{Binding TieLeft}" />
                <Border Grid.Column="1" Background="#7be495" IsVisible="{Binding TieRight}" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- piano roll -->
    <StackPanel Spacing="6" IsVisible="{Binding PianoRollView}">
      <WrapPanel>
        <TextBlock Text="TOOL" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
          <Button Classes="seg" Classes.on="{Binding IsRollDraw}" Content="DRAW" Command="{Binding SetRollToolCommand}" CommandParameter="Draw"
                  ToolTip.Tip="Click an empty cell to add a note (drag to set its length). Drag a note to move it, drag its right edge to resize" />
          <Button Classes="seg" Classes.on="{Binding IsRollSelect}" Content="SELECT" Command="{Binding SetRollToolCommand}" CommandParameter="Select"
                  ToolTip.Tip="Drag a rectangle on empty space to select notes (Draw: hold Cmd/Ctrl)" />
          <Button Classes="seg" Classes.on="{Binding IsRollErase}" Content="ERASE" Command="{Binding SetRollToolCommand}" CommandParameter="Erase"
                  ToolTip.Tip="Click or sweep over notes to delete them (right-click always erases)" />
        </StackPanel>
        <ToggleButton Classes="small blue" Content="FOLD" IsChecked="{Binding RollFold}" Margin="0,0,6,0"
                      ToolTip.Tip="Show only the pitches that hold notes" />
        <ToggleButton Classes="small blue" Content="SCALE" IsChecked="{Binding RollScale}" IsEnabled="{Binding RollScaleAvailable}" Margin="0,0,12,0"
                      ToolTip.Tip="Highlight the rows of the scale of the layer's key (PR.MJ / PR.MN temperaments)" />
        <Button Classes="small" Content="UNDO" Command="{Binding RollUndoCommand}" Margin="0,0,4,0" ToolTip.Tip="Cmd/Ctrl+Z" />
        <Button Classes="small" Content="REDO" Command="{Binding RollRedoCommand}" Margin="0,0,12,0" ToolTip.Tip="Shift+Cmd/Ctrl+Z" />
        <TextBlock Text="PROB" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="seg" Content="25" MinWidth="30" Command="{Binding SetRollProbabilityCommand}" CommandParameter="25" ToolTip.Tip="Probability of the step(s) of the selected notes" />
          <Button Classes="seg" Content="50" MinWidth="30" Command="{Binding SetRollProbabilityCommand}" CommandParameter="50" />
          <Button Classes="seg" Content="75" MinWidth="30" Command="{Binding SetRollProbabilityCommand}" CommandParameter="75" />
          <Button Classes="seg" Content="90" MinWidth="30" Command="{Binding SetRollProbabilityCommand}" CommandParameter="90" />
          <Button Classes="seg" Content="100" MinWidth="34" Command="{Binding SetRollProbabilityCommand}" CommandParameter="100" />
        </StackPanel>
      </WrapPanel>
      <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#2b303a" BorderThickness="1">
        <c:PianoRollControl x:Name="RollView" Editor="{Binding Roll}" Height="430" />
      </Border>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding RollInfoText}" FontSize="12" Foreground="#ffd9a0" VerticalAlignment="Center" MinWidth="220" />
        <TextBlock Grid.Column="1" Text="{Binding RollStatusText}" FontSize="12" Foreground="#ffb454" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Classes="caption" FontSize="10" TextWrapping="Wrap"
                 Text="Click = add note (drag = length) · drag = move · right edge = resize · right-click / sweep = erase · Shift+click = add to selection · Cmd/Ctrl+drag = marquee · Cmd+A / C / V / Z · arrows nudge (Shift = octave) · Cmd+wheel = zoom time · Alt+wheel = zoom pitch · click the ruler to select a step, drag END to change the length" />
    </StackPanel>

    <!-- selected step details -->
    <Border Classes="sub">
      <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="16">
        <StackPanel Spacing="2" MinWidth="90">
          <TextBlock Text="{Binding SelectedStepTitle}" FontWeight="Bold" />
          <TextBlock Text="{Binding SelectedStepProb}" Classes="caption" />
          <TextBlock Text="right-click a step for the menu" Classes="caption" FontSize="10" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="NOTES" Classes="caption" />
          <ItemsControl ItemsSource="{Binding StepNotes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StepNoteRowViewModel">
                <Border Background="#2f6fa8" CornerRadius="4" Padding="6,1" Margin="0,0,4,4">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                    <Button Classes="small" Padding="4,0" MinWidth="20" MinHeight="20" Content="&#x2715;" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete note" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="LOCKS" Classes="caption" />
          <ItemsControl ItemsSource="{Binding StepLocks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StepLockRowViewModel">
                <Border Background="#6b4a1a" CornerRadius="4" Padding="6,1" Margin="0,0,4,4">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                    <Button Classes="small" Padding="4,0" MinWidth="20" MinHeight="20" Content="&#x2715;" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete lock" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" FontSize="10" TextWrapping="Wrap"
                     Text="Hold a step and turn a knob to lock that value on the step. PRM REC records knob moves while playing." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- track controls -->
    <WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
        <TextBlock Text="LENGTH" Classes="caption" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding SeqLengthValue}" Minimum="1" Maximum="64" Increment="1" FormatString="0" Width="100" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
        <TextBlock Text="NOTE" Classes="caption" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding StepNoteChoice.Options}" SelectedItem="{Binding StepNoteChoice.Selected}" MinWidth="86" MaxDropDownHeight="380" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
        <TextBlock Text="RND STEP" Classes="caption" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding RndStepChoice.Options}" SelectedItem="{Binding RndStepChoice.Selected}" MinWidth="76" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
        <TextBlock Text="DUPLICATE" Classes="caption" VerticalAlignment="Center" Margin="0,0,2,0" />
        <Button Classes="small" Content="&#x00D7;2" Command="{Binding DuplicateCommand}" CommandParameter="2" ToolTip.Tip="Double the length by copying the steps" />
        <Button Classes="small" Content="&#x00D7;4" Command="{Binding DuplicateCommand}" CommandParameter="4" ToolTip.Tip="Quadruple the length by copying the steps" />
      </StackPanel>
      <Button Classes="small" Content="CLEAR NOTES" Command="{Binding ClearNotesCommand}" Margin="0,0,6,6" ToolTip.Tip="Remove all notes of this layer's track (locks stay)" />
      <Button Classes="small" Content="CLEAR LOCKS" Command="{Binding ClearAllLocksCommand}" Margin="0,0,14,6" ToolTip.Tip="Remove all parameter locks of this layer's track" />
      <ToggleButton Classes="small blue" Content="RND SEQ" IsChecked="{Binding RndSeqOn}" Margin="0,0,14,6" ToolTip.Tip="Randomized step playback (all layers)" />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
        <TextBlock Text="TRANSPOSE" Classes="caption" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding TransposeValue}" Minimum="-12" Maximum="12" Increment="1" FormatString="+0;-0;0" Width="100" />
      </StackPanel>
      <ToggleButton Classes="small blue" Content="MUTE: SEQ" IsChecked="{Binding MuteSeq}" Margin="0,0,0,6"
                    ToolTip.Tip="Mute mode. Off = SND: a muted layer is silent. On = SEQ: only the sequencer notes of a muted layer are muted (the keyboard still plays it)" />
    </WrapPanel>
  </StackPanel>
</UserControl>
