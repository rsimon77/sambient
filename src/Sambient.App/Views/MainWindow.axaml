<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sambient.App.ViewModels"
        xmlns:audio="using:Sambient.Audio"
        xmlns:c="using:Sambient.App.Controls"
        x:Class="Sambient.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sambient" Width="940" Height="700" MinWidth="780" MinHeight="560">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="SAMBIENT" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                HorizontalAlignment="Left" MinWidth="260" VerticalAlignment="Center">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="audio:AudioDeviceInfo">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ToggleButton Grid.Column="2" Content="Keyboard" IsChecked="{Binding KeyboardVisible}" Margin="0,0,16,0" VerticalAlignment="Center" />
      <c:Knob Grid.Column="4" Label="{Binding MasterKnob.Label}" Value="{Binding MasterKnob.Value, Mode=TwoWay}"
              Minimum="{Binding MasterKnob.Minimum}" Maximum="{Binding MasterKnob.Maximum}"
              DefaultValue="{Binding MasterKnob.DefaultValue}" DisplayText="{Binding MasterKnob.DisplayText}"
              IsLearning="{Binding MasterKnob.IsLearning}" MidiTarget="{Binding MasterKnob.MidiTarget}"
              LearnCommand="{Binding MasterKnob.LearnCommand}" ClearMappingCommand="{Binding MasterKnob.ClearMappingCommand}" />
    </Grid>

    <!-- Layer 1 -->
    <Border Grid.Row="1" Classes="panel" VerticalAlignment="Top">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="LAYER 1" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding MidiLearnStatus}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="Auto,16,*">
          <StackPanel Grid.Column="0" Spacing="8" Width="260">
            <TextBlock Text="WAVE" Classes="caption" />
            <ComboBox ItemsSource="{Binding Waves}" SelectedItem="{Binding SelectedWave}" HorizontalAlignment="Stretch" MaxDropDownHeight="420">
              <ComboBox.Styles>
                <Style Selector="ComboBoxItem">
                  <Setter Property="IsEnabled" Value="{ReflectionBinding IsAvailable}" />
                </Style>
              </ComboBox.Styles>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WaveOption">
                  <TextBlock Text="{Binding Text}" Opacity="{Binding Opacity}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <c:WavePreview Height="96" Table="{Binding PreviewTable}" Harmonic="{Binding PreviewHarmonic}"
                           IsBuilding="{Binding PreviewBuilding}" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,6,0,0">
              <ComboBox Grid.Column="0" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="90">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterOption">
                    <TextBlock Text="{Binding Text}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Classes="small" Content="−" Command="{Binding OctaveDownCommand}" Margin="12,0,0,0" />
              <TextBlock Grid.Column="2" Text="{Binding OctaveText}" VerticalAlignment="Center" Margin="8,0" MinWidth="64" TextAlignment="Center" />
              <Button Grid.Column="3" Classes="small" Content="+" Command="{Binding OctaveUpCommand}" />
            </Grid>
          </StackPanel>

          <ItemsControl Grid.Column="2" ItemsSource="{Binding LayerKnobs}" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParamKnobViewModel">
                <c:Knob Label="{Binding Label}" Value="{Binding Value, Mode=TwoWay}" Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}" DefaultValue="{Binding DefaultValue}" DisplayText="{Binding DisplayText}"
                        IsBipolar="{Binding IsBipolar}" IsLearning="{Binding IsLearning}" MidiTarget="{Binding MidiTarget}"
                        LearnCommand="{Binding LearnCommand}" ClearMappingCommand="{Binding ClearMappingCommand}"
                        Margin="2,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Expander Header="MIDI / Launchkey" Margin="0,4,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LaunchkeyStatus}" />
            <ItemsControl ItemsSource="{Binding MidiPorts}" Opacity="0.7" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <!-- On-screen keyboard (optional) -->
    <Border Grid.Row="2" Classes="panel" Margin="0,12,0,0" IsVisible="{Binding KeyboardVisible}">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="small" Content="◀" Command="{Binding KeyboardOctaveDownCommand}" />
          <TextBlock Text="{Binding KeyboardRangeText}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Center" />
          <Button Classes="small" Content="▶" Command="{Binding KeyboardOctaveUpCommand}" />
          <TextBlock Classes="caption" VerticalAlignment="Center" Margin="12,0,0,0"
                     Text="Computer keys: A W S E D F T G Y/Z H U J K O L P  ·  octave: , and ." />
        </StackPanel>
        <c:PianoKeyboard x:Name="Piano" Height="130" BaseOctave="{Binding KeyboardOctave}" State="{Binding Notes}" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18">
        <TextBlock Text="{Binding Status}" Classes="caption" />
        <TextBlock Text="{Binding LaunchkeyStatus}" Classes="caption" />
        <TextBlock Text="{Binding LastMidiEvent}" Classes="caption" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding VoicesText}" Classes="caption" Margin="0,0,16,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Spacing="2" Width="120" VerticalAlignment="Center">
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding MeterL}" Height="4" MinHeight="4" />
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding MeterR}" Height="4" MinHeight="4" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
