<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sambient.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#16181d" />
      <Setter Property="FontFamily" Value="Inter, Helvetica Neue, sans-serif" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1e2128" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#2a2e37" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8b91a0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="32" />
    </Style>
  </Application.Styles>
</Application>
