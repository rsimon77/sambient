<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sambient.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#16181d" />
      <Setter Property="FontFamily" Value="Inter, Helvetica Neue, sans-serif" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1e2128" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#2a2e37" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8b91a0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="32" />
    </Style>
    <!-- segmented / selector buttons (bank tabs, step pages) -->
    <Style Selector="Button.seg">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#2b2f38" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#b3261e" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- transport / mode toggles -->
    <Style Selector="ToggleButton.rec:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#d32f2f" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.amber:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#ffb454" />
      <Setter Property="Foreground" Value="#16181d" />
    </Style>
    <Style Selector="ToggleButton.blue:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2f6fa8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.playing /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2e9e5b" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- step buttons -->
    <Style Selector="Border.step">
      <Setter Property="Background" Value="#252932" />
      <Setter Property="BorderBrush" Value="#3a3f4b" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Height" Value="60" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.step.on"><Setter Property="Background" Value="#2f6fa8" /></Style>
    <Style Selector="Border.step.play"><Setter Property="Background" Value="#3d4656" /><Setter Property="BorderBrush" Value="#7be495" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="Border.step.on.play"><Setter Property="Background" Value="#5fb3ff" /></Style>
    <Style Selector="Border.step.sel"><Setter Property="BorderBrush" Value="#ffb454" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="Border.step.off"><Setter Property="Opacity" Value="0.28" /></Style>
    <!-- pattern slot buttons -->
    <Style Selector="Button.slot">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#252932" />
      <Setter Property="BorderBrush" Value="#3a3f4b" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Height" Value="54" />
    </Style>
    <Style Selector="Button.slot.user /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2a3140" /></Style>
    <Style Selector="Button.slot.cur /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#b3261e" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.slot.q /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="#ffb454" /><Setter Property="BorderThickness" Value="2" /></Style>
  </Application.Styles>
</Application>
